{
  "name": "my-crush-diary",
  "private": true,
  "version": "0.2.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test tests/*.test.cjs tests/*.test.mjs",
    "dev:backend": "wrangler dev --local",
    "check:backend": "wrangler deploy --dry-run",
    "deploy:backend": "wrangler deploy",
    "check:public": "node tools/verify-public-files.cjs",
    "dev:local": "node tools/local-preview.cjs",
    "test:runtime": "node tools/runtime-smoke.cjs"
  },
  "devDependencies": {
    "wrangler": "^4.149.0"
  }
}
